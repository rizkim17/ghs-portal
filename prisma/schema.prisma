generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
  SISWA
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String?      @unique
  nik           String?      @unique
  password      String
  role          Role         @default(SISWA)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  nilaiUjian    NilaiUjian[]
  biodata       Biodata?
}

model Bab {
  id            String       @id @default(cuid())
  title         String       // Misalnya: "Bab 1: Hiragana & Katakana"
  description   String?
  order         Int          // Urutan bab untuk unlock (1, 2, 3...)
  createdAt     DateTime     @default(now())
  
  soal          Soal[]
  nilaiUjian    NilaiUjian[]
}

model Soal {
  id            String   @id @default(cuid())
  babId         String
  questionText  String   @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A", "B", "C", atau "D"
  createdAt     DateTime @default(now())
  
  bab           Bab      @relation(fields: [babId], references: [id], onDelete: Cascade)
}

model NilaiUjian {
  id            String   @id @default(cuid())
  userId        String
  babId         String
  score         Int      // Nilai dari 0 - 100
  isPassed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bab           Bab      @relation(fields: [babId], references: [id], onDelete: Cascade)
  
  @@unique([userId, babId]) // Siswa hanya punya 1 nilai per bab (bisa diupdate jika remidi)
}

model Biodata {
  id               String   @id @default(cuid())
  userId           String   @unique
  fullNameKanji    String?
  fullNameKatakana String?
  placeOfBirth     String?
  dateOfBirth      DateTime?
  gender           String?  // "L" / "P"
  bloodType        String?
  height           Int?
  weight           Int?
  address          String?  @db.Text
  phone            String?
  
  educationHistory Json?    // Array of { level, schoolName, startYear, endYear }
  workExperience   Json?    // Array of { companyName, position, startYear, endYear }
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
