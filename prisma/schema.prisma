generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
  SISWA
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  nik           String?   @unique
  password      String
  role          Role      @default(SISWA)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relasi akan ditambahkan saat tahap Biodata & Ujian
}
